# Environment Variables for Electron App

# Password Hash (SHA-256)
# To generate a hash for your password, run:
# node -e "console.log(require('crypto').createHash('sha256').update('YOUR_PASSWORD_HERE').digest('hex'))"
#
# Example: For password "Beko@123", the hash is:
# 6c8349cc7260ae62e3b1396831a102cf24813a2e78d4002fad2c984c23c0e935
#
APP_PASSWORD_HASH=6c8349cc7260ae62e3b1396831a102cf24813a2e78d4002fad2c984c23c0e935

# Development/Production Mode
NODE_ENV=production

# Session timeout in milliseconds (default: 30 minutes)
# SESSION_TIMEOUT=1800000
